# UAT development template. Copy this file to .env only when running Vite against UAT.
# .env is local-only and must never be committed. Replace the placeholder host before use.
# Docker-based UAT deployment keeps /api/v1 and proxies it through nginx instead.
VITE_API_URL=/api/v1
API_PROXY_TARGET=https://payroll-uat.example.invalid
